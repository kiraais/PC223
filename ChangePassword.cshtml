@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 450px; margin: 20px auto;">
    <div class="card">
        <div class="card-title">Security Settings</div>

        <!-- INLINE ERROR/SUCCESS BOX -->
        <div id="msgBox" class="alert-error" style="display:none; font-size:12px; margin-bottom:15px;"></div>

        <div class="form-grid" style="grid-template-columns: 1fr;">

            <div class="form-group">
                <label class="form-label">Current Password</label>
                <input type="password" id="txtCurrent" class="form-input" placeholder="Enter current password">
            </div>

            <div class="form-section">New Credentials</div>

            <div class="form-group">
                <label class="form-label">New Password</label>
                <input type="password" id="txtNew" class="form-input" placeholder="Enter new password">
            </div>

            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <input type="password" id="txtConfirm" class="form-input" placeholder="Re-type new password">
            </div>

            <div style="margin-top: 15px;">
                <button id="btnSavePassword" class="btn btn-primary" style="width: 100%; justify-content: center;">Update Password</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $("#btnSavePassword").click(function () {
            let currentP = $("#txtCurrent").val();
            let newP = $("#txtNew").val();
            let confirmP = $("#txtConfirm").val();
            let msgBox = $("#msgBox");

            // Reset box style to error state by default
            msgBox.removeClass("badge-success").addClass("alert-error")
                  .css({ "color": "", "background": "", "border": "" }).hide();

            // 1. Frontend Validation
            if (!currentP || !newP || !confirmP) {
                msgBox.text("Please fill in all password fields.").show();
                return;
            }

            if (newP !== confirmP) {
                msgBox.text("New passwords do not match!").show();
                return;
            }

            if (newP.length < 6) {
                msgBox.text("New password must be at least 6 characters long.").show();
                return;
            }

            // Disable button during processing
            let btn = $(this);
            btn.prop("disabled", true).text("Updating...");

            // 2. AJAX Call
            $.post("@Url.Action("UpdatePassword", "Auth")", {
                currentPass: currentP,
                newPass: newP
            }, function (res) {
                btn.prop("disabled", false).text("Update Password");

                if (res.status == "ok") {
                    // Turn the error box green for success!
                    msgBox.removeClass("alert-error")
                          .css({ "color": "var(--success)", "background": "var(--success-bg)", "border": "1px solid #bbf7d0" })
                          .text(res.message + " You can now use your new password.").show();

                    // Clear inputs
                    $("#txtCurrent, #txtNew, #txtConfirm").val("");
                } else {
                    msgBox.text(res.message).show();
                }
            }).fail(function () {
                btn.prop("disabled", false).text("Update Password");
                msgBox.text("Server Error. Please try again.").show();
            });
        });
    </script>
}